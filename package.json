{
  "name": "@finqo-app/common",
  "version": "2.2.0",
  "description": "Shared pure utilities for Finqo web and mobile — currency formatting, amount parsing, date helpers, and validation. No business logic or domain knowledge.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "finqo",
    "shared",
    "utilities"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
